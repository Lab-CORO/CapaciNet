FROM curobo_ros:aarch64-jazzy

# ── Base: curobo-ros-jazzy (CUDA 13.2 / Ubuntu 24.04 Noble / Python 3.12)
# Déjà disponible dans la base :
#   Python 3.12, PyTorch 2.12.1 (SM_87, built from source), CuRobo v0.8.0,
#   numpy 1.26.4, ROS2 Jazzy + ros-jazzy-*

LABEL maintainer="Lab-CORO"
LABEL description="CapacityNet Reachability Node — ROS2 Jazzy + PyTorch (aarch64, Jetson Orin)"
LABEL ros.distro="jazzy"
LABEL pytorch.version="2.12.1"
LABEL python.version="3.12"

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Montreal

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 1 — Dépendances Python CapacityNet
# open3d est déjà dans la base — on installe uniquement ce qui manque.
# ═══════════════════════════════════════════════════════════════════════════════
RUN pip3 install --no-cache-dir \
    h5py \
    scikit-image \
    tensorboard \
    pyyaml \
    "empy==3.3.4" \
    lark \
    catkin_pkg

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 2 — pytorch-3dunet (installation depuis les sources)
# Pas de wheel aarch64 précompilé sur PyPI ni conda-forge.
# Le source dist est pure Python + dépendances standard → compile sur aarch64.
#
# CRITIQUE : --no-deps est OBLIGATOIRE. pytorch-3dunet déclare `torch` et
# `torchvision` en dépendances ; sans --no-deps, pip télécharge le wheel
# torch SBSA de PyPI (manylinux_2_28_aarch64) qui N'A PAS sm_87 et ÉCRASE
# notre PyTorch compilé pour l'Orin → GPU inutilisable.
# Toutes les vraies deps sont déjà présentes :
#   torch (base, sm_87) · numpy/scipy (base) · h5py/scikit-image/tensorboard (ÉTAPE 1)
#   torchvision : déclaré mais jamais importé par le code → non installé.
# ═══════════════════════════════════════════════════════════════════════════════
RUN git clone --depth=1 https://github.com/wolny/pytorch-3dunet.git /tmp/pytorch-3dunet && \
    cd /tmp/pytorch-3dunet && \
    SETUPTOOLS_SCM_PRETEND_VERSION=1.0.0 pip3 install --no-cache-dir --no-build-isolation --ignore-requires-python --no-deps . && \
    rm -rf /tmp/pytorch-3dunet

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 3 — Re-pin numpy<2
# pytorch-3dunet ou ses dépendances peuvent remonter numpy 2.x.
# La base curobo-ros-jazzy pin numpy==1.26.4 (compat numba/cupy) — doit rester <2.
# ═══════════════════════════════════════════════════════════════════════════════
RUN pip3 install --no-cache-dir "numpy<2"

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 3b — TensorRT 10.16 (inférence UNet3D via reachability_engine/trt_model)
#
# Le runtime nvidia (mode CSV) ne monte PAS TensorRT dans le conteneur ; il faut
# l'installer. On épingle un set COHÉRENT 10.16.1.11 (python3-libnvinfer tire
# libnvinfer10/plugin/onnxparsers à la même version), sinon apt prend des versions
# mélangées (python bindings en 11.x). libnvinfer-bin fournit trtexec.
#
# IMPORTANT : un engine .trt n'est compatible qu'avec SA version de TensorRT.
# L'engine doit donc être (re)construit DANS ce conteneur avec ce TRT 10.16.1
# (build trtexec = au runtime, il faut un GPU — impossible pendant docker build).
# ═══════════════════════════════════════════════════════════════════════════════
ARG TRT_VERSION=10.16.1.11-1+cuda13.2
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-libnvinfer=${TRT_VERSION} \
        libnvinfer-bin=${TRT_VERSION} \
    && rm -rf /var/lib/apt/lists/* && \
    python3 -c "import tensorrt as trt; print('TensorRT python:', trt.__version__)"

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 4 — Workspace ROS2 CapacityNet
# ═══════════════════════════════════════════════════════════════════════════════
RUN mkdir -p /workspace/capacitynet/ros2_ws/src
WORKDIR /workspace/capacitynet/ros2_ws/src

RUN git clone https://github.com/Lab-CORO/curobo_msgs.git

# reachability_map_visualizer : dépendance de capacitynet (package.xml).
# Requis pour le colcon build de capacitynet monté au runtime (mode DEV).
RUN git clone https://github.com/Lab-CORO/reachability_map_visualizer.git

# Deps système de reachability_map_visualizer (plugin RViz Qt + HDF5).
# rviz2/rviz_common/rviz_rendering/pluginlib viennent de ros-jazzy-desktop (base).
RUN apt-get update && apt-get install -y --no-install-recommends \
    qtbase5-dev libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# COPY src/ ici si on veut embarquer le code au moment du build :
# COPY ./ros2_ws/src/capacitynet /workspace/capacitynet/ros2_ws/src/capacitynet

WORKDIR /workspace/capacitynet/ros2_ws
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && \
    colcon build --symlink-install"

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 4b — RMW : Cyclone DDS (remplace FastDDS)
# Meilleur comportement sur gros messages (PointCloud2 reachability_map) et config
# plus simple. DOIT être identique sur TOUT le graphe ROS (capacitynet + leeloo),
# sinon capacitynet ne reçoit plus /curobo_trajectory_planner/voxel_grid_sparse.
# ═══════════════════════════════════════════════════════════════════════════════
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 5 — Entrypoint (sans conda — Python 3.12 global hérité de la base)
# ═══════════════════════════════════════════════════════════════════════════════
RUN printf '#!/bin/bash\nset -e\nsource /opt/ros/jazzy/setup.bash\nsource /workspace/capacitynet/ros2_ws/install/setup.bash 2>/dev/null || true\nexport CUDA_LAUNCH_BLOCKING=0\nexport PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512\necho "========================================"\necho "CapacityNet ROS2 Environment (aarch64)"\necho "========================================"\necho "ROS2 Distro: $(printenv ROS_DISTRO)"\necho "Python: $(python3 --version)"\npython3 -c "import torch; print('"'"'PyTorch: '"'"' + torch.__version__)" 2>/dev/null || echo "PyTorch: not loaded"\npython3 -c "import torch; print('"'"'CUDA Available: '"'"' + str(torch.cuda.is_available()))" 2>/dev/null || true\npython3 -c "from pytorch3dunet.unet3d import model; print('"'"'pytorch-3dunet: OK'"'"')" 2>/dev/null || echo "pytorch-3dunet: import error"\necho "========================================"\nexec "$@"\n' > /workspace/entrypoint.sh && chmod +x /workspace/entrypoint.sh

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 6 — Scripts utilitaires
# ═══════════════════════════════════════════════════════════════════════════════
RUN printf '#!/bin/bash\necho "Recompilation du workspace ROS2..."\ncd /workspace/capacitynet/ros2_ws\nsource /opt/ros/jazzy/setup.bash\ncolcon build --symlink-install\necho "Compilation terminee!"\n' > /workspace/rebuild.sh && chmod +x /workspace/rebuild.sh

RUN printf '#!/bin/bash\necho "Lancement du noeud CapacityNet Reachability..."\npython3 /workspace/capacitynet/ros2_ws/src/capacitynet/capacitynet/capacitynet.py\n' > /workspace/launch_node.sh && chmod +x /workspace/launch_node.sh

# ═══════════════════════════════════════════════════════════════════════════════
# ÉTAPE 7 — .bashrc
# ═══════════════════════════════════════════════════════════════════════════════
RUN echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc && \
    echo 'source /workspace/capacitynet/ros2_ws/install/setup.bash 2>/dev/null || true' >> ~/.bashrc && \
    echo 'export CUDA_LAUNCH_BLOCKING=0' >> ~/.bashrc && \
    echo 'export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512' >> ~/.bashrc && \
    echo 'export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp' >> ~/.bashrc && \
    echo 'alias rebuild="/workspace/rebuild.sh"' >> ~/.bashrc && \
    echo 'alias launch="/workspace/launch_node.sh"' >> ~/.bashrc

WORKDIR /workspace/capacitynet

ENTRYPOINT ["/workspace/entrypoint.sh"]
CMD ["/bin/bash"]

# ── Utilisation ───────────────────────────────────────────────────────────────
# Prérequis : image curobo_ros:aarch64-jazzy présente sur le Jetson
#   docker build -f leeloo/curobo_ros/docker/aarch64_jazzy.dockerfile \
#       -t curobo_ros:aarch64-jazzy .
#
# Build CapacityNet (depuis CapaciNet/unet_3d/) :
#   docker build -f Dockerfile.aarch64 -t capacitynet:latest .
#
# Run (mode DEV — monter le code source) :
#   docker run --gpus all -it --rm \
#       -v $(pwd):/workspace/capacitynet \
#       --network host \
#       capacitynet:latest
#
# Lancer le nœud directement :
#   docker run --gpus all --rm \
#       -v $(pwd):/workspace/capacitynet \
#       --network host \
#       capacitynet:latest /workspace/launch_node.sh
